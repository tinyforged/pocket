{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pocket",
  "version": "0.1.0-alpha.2",
  "identifier": "dev.tinyforged.pocket",
  "mainBinaryName": "pocket",
  "build": {
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "frontend/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Pocket",
        "width": 1080,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGOTg5NUU4MjI3M0FCOUUKUldTZXEzTWk2SldZL3p3VGI3SldqN3p4TWV4YWtIRlZWRW84V05EbHdPZ3F3dEVtNkRYUTZSSEoK",
      "endpoints": [
        "https://github.com/tinyforged/pocket/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["dmg", "appimage", "deb", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
